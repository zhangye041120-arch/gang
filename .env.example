DEEPSEEK_BASE_URL=https://api.deepseek.com/v1
APP_ENV=development
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-v4-flash

QWEN_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
QWEN_API_KEY=
QWEN_MODEL=qwen3.7-flash-2026-07-15

AGENT_TEMPERATURE=0.3
AGENT_MAX_TOKENS=800
INSPECTOR_MAX_TOKENS=256
# Qwen3.7 系列默认开启思考模式，副模型会先“想”5-16 秒。Inspector 是结构化
# 安全质检，不需要长思考链，生产建议保持 false 以换取低延迟。
INSPECTOR_ENABLE_THINKING=false
# 快检存疑时（issues、软性不合格、非 none 的 error_pattern 或主模型 risk_hint）
# 自动升级为开思考的强检复核；普通对话保持快检，不触发升级。
INSPECTOR_ESCALATE_ON_ISSUES=true
# 实时事实能力：当前时间用本机时钟；天气/附近/节假日/新闻/药品科普统一走
# 联网搜索（需要配置 WEB_SEARCH_API_KEY，serper/tavily/brave 三选一）。
# 天气走免 key 的实时天气接口（wttr.in），拿不到时才回退联网搜索。
LIVE_LOOKUP_ENABLED=true
LIVE_LOOKUP_TIMEOUT_SECONDS=3
LIVE_DEFAULT_CITY=沈阳
# 天气数据源：wttr=实时天气接口（默认，无需 key）；web_search=回退到联网搜索
WEATHER_PROVIDER=wttr
WEATHER_API_BASE=https://wttr.in
WEATHER_TIMEOUT_SECONDS=6
WEATHER_CACHE_TTL_MINUTES=10
WEB_SEARCH_ENABLED=true
# dashscope 使用现有 QWEN_API_KEY + QWEN_BASE_URL；其他提供商才需要 WEB_SEARCH_API_KEY
WEB_SEARCH_PROVIDER=dashscope
WEB_SEARCH_DASHSCOPE_MODEL=qwen3.7-flash-2026-07-15
WEB_SEARCH_FORCED_SEARCH=false
WEB_SEARCH_API_KEY=
WEB_SEARCH_TIMEOUT_SECONDS=45
WEB_SEARCH_MAX_RESULTS=5
# 提醒工具：本地记录，不修改系统；真实推送待 Java/企微
REMINDERS_ENABLED=true
AGENT_TIMEOUT_SECONDS=60
AGENT_STREAM_TIMEOUT_SECONDS=60
RAG_PARALLEL_ENABLED=true
AGENT_TOP_K=3

# Knowledge production settings. Leave the database URL empty to use lexical fallback.
KNOWLEDGE_VERSION=v1
EMBEDDING_PROVIDER=qwen
EMBEDDING_MODEL=text-embedding-v4
EMBEDDING_DIMENSION=1536
KNOWLEDGE_DATABASE_URL=
# 召回候选使用 qwen3-rerank 二次排序，需要 QWEN_API_KEY；重排失败自动回退融合检索
RERANK_ENABLED=false
RERANK_BASE_URL=https://dashscope.aliyuncs.com/api/v1
RERANK_MODEL=qwen3-rerank
RERANK_CANDIDATES=12
RERANK_TIMEOUT_SECONDS=30
PROMPT_VERSION=1.7.0
ACTION_DECLINE_COOLDOWN_HOURS=24
QUALITY_HASH_SALT=change-in-production
LESSON_SEARCH_TOP_K=2
MEMORY_VECTOR_SEARCH_ENABLED=true
MEMORY_VECTOR_MIN_SCORE=0.55
API_TOKEN=
API_DEBUG_TOKEN=
API_ADMIN_TOKEN=
API_DEBUG_ENABLED=false
API_PORT=8081
API_TEST_MODE=false
API_RATE_LIMIT_PER_MINUTE=60
API_RATE_LIMIT_PER_USER=20
API_TRUSTED_HOSTS=localhost,127.0.0.1
API_MAX_REQUEST_BYTES=262144
API_WORKERS=2
API_GRACEFUL_SHUTDOWN_SECONDS=90
API_KEEP_ALIVE_SECONDS=5
API_FORWARDED_ALLOW_IPS=127.0.0.1
API_METRICS_ENABLED=true
REDIS_URL=
REDIS_KEY_PREFIX=xiaoliao
IDEMPOTENCY_TTL_SECONDS=86400
IDEMPOTENCY_EXECUTION_TTL_SECONDS=300
NONCE_TTL_SECONDS=900
GATEWAY_HMAC_SECRET=
GATEWAY_CLOCK_SKEW_SECONDS=300
PRIVACY_HMAC_SECRET=
PRIVACY_HMAC_KEY_VERSION=v1
# JSON 对象；轮换后保留旧版本，直到所有墓碑/幂等窗口完成迁移。
PRIVACY_HMAC_PREVIOUS_KEYS={}
BACKUP_RETENTION_DAYS=30
CRISIS_ROUTE=unconfigured
CRISIS_RETENTION_DAYS=365
CRISIS_NOTIFICATION_ATTEMPTS=2
CRISIS_REFERRAL_CONFIG_PATH=
# 危机通知收件人（企微用户ID，逗号分隔）；配置后即使路由未指定也会尝试发送
CRISIS_NOTIFICATION_RECIPIENTS=
# 企业微信应用消息：给内部员工发私信用，用户级签到提醒需要这三项
WECOM_CORP_ID=
WECOM_AGENT_ID=
WECOM_AGENT_SECRET=
WECOM_CALLBACK_TOKEN=
WECOM_ENCODING_AES_KEY=
WECOM_ACTIVE_GREETING_ENABLED=false
WECOM_ACTIVE_GREETING_MAX_PER_DAY=1
WECOM_ACTIVE_GREETING_RECENT_ACTIVE_HOURS=24
WECOM_DEDUP_RETENTION_HOURS=168
# 企微员工群每日签到提醒（群机器人 Webhook，仅内部员工群）
# 微信客服的 48 小时窗口不适用于内部员工群，员工群可以每天定时推送。
WECOM_CHECKIN_REMINDER_ENABLED=false
WECOM_CHECKIN_GROUP_WEBHOOK=
# 群机器人启用“加签”时填写，未启用可留空
WECOM_CHECKIN_GROUP_WEBHOOK_SECRET=
# 支持多个时间点，逗号分隔，例如 09:00,15:00
WECOM_CHECKIN_GROUP_TIMES=09:00
WECOM_CHECKIN_GROUP_MESSAGE=小辽提醒：方便的时候花一分钟完成今天的情绪签到吧，记下此刻的心情就好，不用着急。
WECOM_CHECKIN_GROUP_MENTION_ALL=false
WECOM_CHECKIN_GROUP_MENTIONED_USERS=
WECOM_CHECKIN_GROUP_MENTIONED_MOBILES=
# 服务短暂停机后允许补发的分钟数，超过窗口则当天跳过
WECOM_CHECKIN_GROUP_CATCH_UP_MINUTES=15
# 幂等状态持久化路径，留空为内存模式；生产建议填写本地文件，例如 运行/checkin_reminder_state.sqlite3
WECOM_CHECKIN_GROUP_STATE_PATH=
# 用户级习惯时间表（JSON 文件），配置后按个人时间通过应用消息发私信；
# 留空时回退到 WECOM_CHECKIN_GROUP_TIMES 的群统一时间。格式参考 checkin_user_schedule.example.json
WECOM_CHECKIN_GROUP_USER_SCHEDULE_PATH=
MEMORY_CONFIDENCE_THRESHOLD=0.8
MEMORY_MAX_ITEMS=20
MEMORY_MAX_CHARS=8000
# 主模型（DeepSeek）失败时尝试 Qwen 作为备用生成模型；质检失败时退回确定性安全规则
MODEL_FALLBACK_ENABLED=true
# 适老化禁用词确定性校验，命中后自动替换为温和表达
AGING_WORDLIST_ENFORCED=true
# 语音合成（DashScope Qwen-Audio-TTS/CosyVoice）
TTS_ENABLED=false
TTS_BASE_URL=https://dashscope.aliyuncs.com/api/v1
TTS_MODEL=qwen-audio-3.0-tts-flash
TTS_VOICE=longanhuan_v3.6
TTS_FORMAT=wav
TTS_SAMPLE_RATE=24000

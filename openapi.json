  "components": {
    "schemas": {
      "ApiError": {
        "properties": {
          "error_code": {
            "type": "string",
            "title": "Error Code"
          },
          "request_id": {
            "type": "string",
            "title": "Request Id"
          },
          "message": {
            "type": "string",
            "title": "Message",
            "default": ""
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "error_code",
          "request_id"
        ],
        "title": "ApiError",
        "description": "Uniform error body for every non-200 v1 response."
      },
      "ChatRequest": {
        "properties": {
          "userId": {
            "type": "string",
            "maxLength": 64,
            "minLength": 1,
            "pattern": "^[A-Za-z0-9_:@.-]+$",
            "title": "Userid"
          },
          "message": {
            "type": "string",
            "maxLength": 2000,
            "minLength": 1,
            "title": "Message"
          },
          "conversationHistory": {
            "items": {
              "$ref": "#/components/schemas/ConversationMessage"
            },
            "type": "array",
            "maxItems": 30,
            "title": "Conversationhistory"
          }
        },
        "type": "object",
        "required": [
          "userId",
          "message"
        ],
        "title": "ChatRequest"
      },
      "ChatResponse": {
        "properties": {
          "reply": {
            "type": "string",
            "title": "Reply"
          },
          "intent": {
            "type": "string",
            "enum": [
              "chat",
              "checkin",
              "game",
              "exercise",
              "assessment",
              "community"
            ],
            "title": "Intent"
          },
          "inspection": {
            "additionalProperties": true,
            "type": "object",
            "title": "Inspection"
          },
          "retrievedContexts": {
            "items": {
              "additionalProperties": true,
              "type": "object"
            },
            "type": "array",
            "title": "Retrievedcontexts"
          }
        },
        "type": "object",
        "required": [
          "reply",
          "intent"
        ],
        "title": "ChatResponse"
      },
      "ConsentRequest": {
        "properties": {
          "user_id": {
            "type": "string",
            "maxLength": 64,
            "minLength": 1,
            "pattern": "^[A-Za-z0-9_:@.-]+$",
            "title": "User Id"
          },
          "personalization": {
            "type": "boolean",
            "title": "Personalization",
            "default": false
          },
          "sensitive": {
            "type": "boolean",
            "title": "Sensitive",
            "default": false
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "user_id"
        ],
        "title": "ConsentRequest"
      },
      "ConversationMessage": {
        "properties": {
          "role": {
            "type": "string",
            "enum": [
              "user",
              "assistant"
            ],
            "title": "Role"
          },
          "content": {
            "type": "string",
            "maxLength": 4000,
            "minLength": 1,
            "title": "Content"
          }
        },
        "type": "object",
        "required": [
          "role",
          "content"
        ],
        "title": "ConversationMessage"
      },
      "DeleteUserRequest": {
        "properties": {
          "user_id": {
            "type": "string",
            "maxLength": 64,
            "minLength": 1,
            "pattern": "^[A-Za-z0-9_:@.-]+$",
            "title": "User Id"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "user_id"
        ],
        "title": "DeleteUserRequest"
      },
      "SpeechRequest": {
        "properties": {
          "text": {
            "type": "string",
            "maxLength": 2000,
            "minLength": 1,
            "title": "Text"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "text"
        ],
        "title": "SpeechRequest"
      },
      "V1Accessibility": {
        "properties": {
          "large_text": {
            "type": "boolean",
            "title": "Large Text",
            "default": false
          },
          "high_contrast": {
            "type": "boolean",
            "title": "High Contrast",
            "default": false
          },
          "voice_enabled": {
            "type": "boolean",
            "title": "Voice Enabled",
            "default": false
          }
        },
        "additionalProperties": false,
        "type": "object",
        "title": "V1Accessibility"
      },
      "V1ChatRequest": {
        "properties": {
          "user_id": {
            "type": "string",
            "maxLength": 64,
            "minLength": 1,
            "pattern": "^[A-Za-z0-9_:@.-]+$",
            "title": "User Id"
          },
          "session_id": {
            "type": "string",
            "maxLength": 128,
            "minLength": 1,
            "pattern": "^[A-Za-z0-9_:@.-]+$",
            "title": "Session Id"
          },
          "message": {
            "type": "string",
            "maxLength": 2000,
            "minLength": 1,
            "title": "Message"
          },
          "context": {
            "$ref": "#/components/schemas/V1Context"
          },
          "conversation_history": {
            "items": {
              "$ref": "#/components/schemas/V1ConversationMessage"
            },
            "type": "array",
            "maxItems": 30,
            "title": "Conversation History"
          },
          "debug": {
            "type": "boolean",
            "title": "Debug",
            "default": false
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "user_id",
          "session_id",
          "message"
        ],
        "title": "V1ChatRequest"
      },
      "V1ChatResponse": {
        "properties": {
          "session_id": {
            "type": "string",
            "title": "Session Id"
          },
          "reply": {
            "type": "string",
            "title": "Reply"
          },
          "intent": {
            "type": "string",
            "enum": [
              "chat",
              "checkin",
              "game",
              "exercise",
              "assessment",
              "community"
